<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ShopSphere Automated Regression Suite" verbose="1" parallel="none">
    <!--
      Architectural Decision:
      Tests run sequentially (parallel="none") to ensure deterministic stability against the public shared demo.
      DriverFactory utilizes ThreadLocal<WebDriver> so parallel thread count can be enabled seamlessly
      when dedicated staging environments with data isolation become available.
    -->
    <listeners>
        <listener class-name="com.shopsphere.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Smoke &amp; Critical Flows">
        <classes>
            <class name="com.shopsphere.tests.SmokeTest"/>
        </classes>
    </test>

    <test name="Product Discovery &amp; Search">
        <classes>
            <class name="com.shopsphere.tests.SearchTest"/>
        </classes>
    </test>

    <test name="Shopping Cart Lifecycle &amp; Boundaries">
        <classes>
            <class name="com.shopsphere.tests.CartTest"/>
        </classes>
    </test>

    <test name="Product Details &amp; Specifications">
        <classes>
            <class name="com.shopsphere.tests.ProductDetailsTest"/>
        </classes>
    </test>

    <test name="Customer Wishlist Management">
        <classes>
            <class name="com.shopsphere.tests.WishlistTest"/>
        </classes>
    </test>

    <test name="Customer Account Registration">
        <classes>
            <class name="com.shopsphere.tests.RegistrationTest"/>
        </classes>
    </test>

    <test name="Customer Authentication &amp; Recovery">
        <classes>
            <class name="com.shopsphere.tests.AuthenticationTest"/>
        </classes>
    </test>

    <test name="Category &amp; Catalog Navigation">
        <classes>
            <class name="com.shopsphere.tests.CategoryNavigationTest"/>
        </classes>
    </test>

    <test name="Footer Links &amp; Customer Services">
        <classes>
            <class name="com.shopsphere.tests.FooterAndCustomerServiceTest"/>
        </classes>
    </test>
</suite>
