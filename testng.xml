<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ShopSphere Automated Regression Suite" verbose="1" parallel="none">
    <!--
      Architectural Decision:
      Tests run sequentially (parallel="none") to ensure deterministic stability against the public shared demo.
      DriverFactory utilizes ThreadLocal<WebDriver> so parallel thread count can be enabled seamlessly
      when dedicated staging environments with data isolation become available.
    -->
    <listeners>
        <listener class-name="com.shopsphere.listeners.TestListener"/>
    </listeners>

    <test name="Smoke &amp; Critical Flows">
        <classes>
            <class name="com.shopsphere.tests.SmokeTest"/>
        </classes>
    </test>

    <test name="Product Discovery &amp; Search">
        <classes>
            <class name="com.shopsphere.tests.SearchTest"/>
        </classes>
    </test>

    <test name="Shopping Cart Lifecycle">
        <classes>
            <class name="com.shopsphere.tests.CartTest"/>
        </classes>
    </test>

    <test name="Navigation &amp; Routing">
        <classes>
            <class name="com.shopsphere.tests.NavigationTest"/>
        </classes>
    </test>

    <test name="Authentication Guardrails">
        <classes>
            <class name="com.shopsphere.tests.AuthenticationNegativeTest"/>
        </classes>
    </test>
</suite>
